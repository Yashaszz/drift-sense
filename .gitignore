# ==========================================================================
# Drift-Sense project-specific
# ==========================================================================

# Agent / editor local state
.claude/
.cursor/
.idea/
*.code-workspace

# Generated datasets. Generation is seed-reproducible (see generate_dataset.py),
# so the pairs are rebuilt from the seed rather than committed. Keeping them out
# also stops the repo bloating with thousands of 1000x1000 PNGs.
data/
*.npy
*.npz
!tests/fixtures/**/*.npy

# Evaluation output: metrics, plots, per-stratum tables. Regenerated by evaluate.py.
results/
*.prof
*.lprof

# Trained model artefacts (Stage 6 confidence model, optional re-ranker).
# localize() must work without these; they are never a hard dependency.
models/
*.joblib
*.pkl
*.pt
*.pth

# Submission bundle
submission/
*.zip

# Tooling caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*

# NOTE: uv.lock is deliberately NOT ignored. This is an application, not a
# library, and the submission has to reproduce an exact environment. The
# lockfile is what makes every teammate's machine, CI, and the graders' clean
# unzip resolve to the same versions.

